+function routeHint(h: Health | null): string {
+  if (!h) return '서버 상태를 확인하는 중입니다'
+  if (h.offline_mode) return '완전 로컬 모드 · 비용 0원 · 외부 전송 없음'
+  if (h.search_mode === 'keyword') return '구절 검색만 · 비용 0원 · 외부 전송 없음'
+  if (!h.paid_apis_enabled) return '유료 API 잠김 · 찾은 구절만 보여 줍니다 · 비용 0원 · 외부 전송 없음'
+  return 'AI 요약 켜짐 · 질문과 논문 발췌가 외부 AI로 전송되고 비용이 듭니다'
+}
+
+/** 「이 논문만」으로 물었을 때 AI에게 건넨 분량. 다 못 건넸으면 눈에 띄게 알린다. */
+function CoverageLine({ items }: { items: Coverage[] }) {
+  const cut = items.filter((c) => c.truncated)
+  const pct = (c: Coverage) => Math.round((100 * c.read_chars) / Math.max(1, c.total_chars))
+  const text = !cut.length
+    ? `📖 ${items.length > 1 ? `${items.length}편 모두` : '이 논문'} 처음부터 끝까지 읽고 답했습니다`
+    : items.length === 1
+      ? `📖 ${cut[0].pages}쪽 가운데 ${cut[0].read_until_page}쪽까지만 읽고 답했습니다 (글자 수로 ${pct(cut[0])}%) — 뒷부분 내용은 답에 없을 수 있습니다`
+      : `📖 ${items.length}편 가운데 ${cut.length}편은 앞부분만 읽고 답했습니다 (${cut
+          .slice(0, 3)
+          .map((c) => `${c.read_until_page}/${c.pages}쪽`)
+          .join(', ')}${cut.length > 3 ? ' …' : ''})`
+  return <div className={`pa-chat-cover${cut.length ? ' cut' : ''}`}>{text}</div>
+}
