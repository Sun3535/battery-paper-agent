+/* ---------- 점검(2026-10-14) 뒤에 더한 것 ---------- */
+/* 카드의 실패·건너뜀 사유 — 두 줄까지만, 전체는 마우스를 올리면 보인다 */
+.pa-tile-note {
+  display: flex;
+  gap: 6px;
+  align-items: flex-start;
+  margin: 8px 4px 0;
+  padding: 6px 8px;
+  border-radius: 10px;
+  font-size: 11.5px;
+  line-height: 1.5;
+  color: #92400e;
+  background: #fffbeb;
+  box-shadow: inset 0 0 0 1px rgba(217, 119, 6, 0.22);
+}
+.pa-tile-note.failed {
+  color: #b91c1c;
+  background: #fef2f2;
+  box-shadow: inset 0 0 0 1px rgba(220, 38, 38, 0.22);
+}
+.pa-tile-note .anticon {
+  margin-top: 2px;
+  flex-shrink: 0;
+}
+.pa-tile-note span:last-child {
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  overflow-wrap: anywhere;
+}
+/* 리더: 긴 화학식·주소가 종이 밖으로 나가지 않게 */
+.reader-body {
+  overflow-wrap: anywhere;
+}
+.pa-reader .ant-drawer-header-title,
+.pa-reader .ant-drawer-title {
+  min-width: 0;
+}
+.reader-body .rd-notice .why {
+  margin-top: 4px;
+  font-size: 12px;
+  color: var(--rd-notice-ink);
+  overflow-wrap: anywhere;
+}
+/* 「나란히」: 캡션·소제목의 원문 */
+.reader-body figcaption.rd-cap-en {
+  margin-top: 0.4em;
+  font-size: 0.8em;
+  color: var(--rd-faint);
+}
+.reader-body h2 .rd-h-en {
+  display: block;
+  margin-top: 0.25em;
+  font-size: 0.72em;
+  font-weight: 500;
+  letter-spacing: 0;
+  color: var(--rd-faint);
+}
+/* 챗봇: AI에게 건넨 분량 */
+.pa-chat-cover {
+  margin-top: 10px;
+  padding: 7px 10px;
+  border-radius: 10px;
+  font-size: 12px;
+  line-height: 1.6;
+  color: #166534;
+  background: #f0fdf4;
+  box-shadow: inset 0 0 0 1px rgba(22, 101, 52, 0.16);
+}
+.pa-chat-cover.cut {
+  color: #92400e;
+  background: #fffbeb;
+  box-shadow: inset 0 0 0 1px rgba(217, 119, 6, 0.24);
+}
+
+/* ---------- 2차 점검(2026-10-14) 뒤에 더한 것 ---------- */
+/* 고른 보기 버튼에 마우스를 올리면 글자가 바탕색에 묻혔다 */
+.pa-tbtn.active:hover:not(:disabled) {
+  color: #fff;
+}
+/* 리더 안내: 버튼이 있으면 좁은 화면에서 글 칸이 눌렸다 → 버튼을 다음 줄로 */
+.reader-body .rd-notice {
+  flex-wrap: wrap;
+}
+.reader-body .rd-notice .txt {
+  flex-basis: 220px;
+}
+/* 챗봇: 참고로 붙은 다른 논문 */
+.pa-ref-tag {
+  display: inline-block;
+  margin-right: 6px;
+  padding: 0 7px;
+  border-radius: 9999px;
+  font-size: 10.5px;
+  font-weight: 600;
+  color: #6b7280;
+  background: #f3f4f6;
+  vertical-align: 1px;
+}
+/* 아주 좁은 창: 메뉴바 글자를 줄여 [사용자] 버튼이 화면 밖으로 밀리지 않게 */
+@media (max-width: 560px) {
+  .pa-cost .long {
+    display: none;
+  }
+  .pa-nav .pa-ghost .lbl {
+    display: none;
+  }
+  .pa-nav .pa-ghost {
+    padding: 0 9px;
+  }
+}
+
