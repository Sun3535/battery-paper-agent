+def doc_analyses(conn: sqlite3.Connection, doc_id: str, limit: int = 3) -> list[dict]:
+    """그 논문의 그림 분석을 앞에서부터 limit 건 — 질문 낱말과 겹치지 않아도.
+
+    논문을 정해 놓고 묻는 질문("그림 3을 설명해줘", "요약해줘")은 한국어 낱말이 영어 분석문·캡션과
+    겹치지 않아 relevant_analyses 가 0건을 돌려주곤 했다(2026-10-14 점검: 14번 중 12번).
+    돈 내고 만든 분석이 있는 논문을 골라 물었다면 그 분석은 넣어 준다.
+    """
+    ensure_table(conn)
+    rows = conn.execute(
+        """SELECT fa.analysis_ko, d.title, b.page FROM figure_analyses fa
+           JOIN documents d ON d.doc_id = fa.doc_id
+           JOIN blocks b ON b.doc_id = fa.doc_id AND b.block_order = fa.block_order
+           WHERE fa.doc_id = ? ORDER BY fa.block_order LIMIT ?""",
+        (doc_id, limit),
+    ).fetchall()
+    return [{"analysis": r["analysis_ko"], "title": r["title"], "page": r["page"]} for r in rows]
+
