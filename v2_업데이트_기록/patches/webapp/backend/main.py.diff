+            order.append(title)
+        if page.isdigit():
+            pages[title].append(int(page))
+    out = []
+    for t in order:
+        ps = sorted(set(pages[t]))
+        if not ps:
+            out.append(t)
+        elif len(ps) == 1:
+            out.append(f"{t} p{ps[0]}")
+        else:
+            out.append(f"{t} p{ps[0]}~{ps[-1]}")
+    return out
