+    **진행 중인** 번역이 "서버가 꺼졌습니다" 로 바뀌었다(그 뒤 [이어서 번역] 을 누르면 이중 과금 위험).
+    """
+    global _INSTANCE_LOCK
+    path = store.DB_PATH.with_suffix(".server.lock")
+    try:
+        f = open(path, "a+b")
+        if sys.platform == "win32":
+            import msvcrt
+
+            msvcrt.locking(f.fileno(), msvcrt.LK_NBLCK, 1)
+        else:
+            import fcntl
+
+            fcntl.flock(f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except OSError:
+        return False  # 다른 서버가 쥐고 있다 — 그 서버의 진행 중 작업을 건드리지 않는다
+    _INSTANCE_LOCK = f
+    return True
