# ══════════════════════════════════════════════════════════════
#  Battery Paper Agent — 설정 파일 예시
#
#  이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 값을 고치세요.
#  (파일 이름이 정확히 ".env" 여야 합니다. 앞의 점을 빼먹지 마세요)
#
#  ⚠️ API 키는 여기 넣지 않습니다. 앱을 켜고 화면 우측 상단
#     [사용자] → [API] 에서 각자 자기 키를 등록하세요.
#     그래야 사람마다 자기 키로 과금됩니다.
# ══════════════════════════════════════════════════════════════

# ── 💰 유료 API 스위치 ────────────────────────────────────────
# false = 돈 나가는 호출을 전부 차단 (번역·그림분석·AI요약)
# true  = 사용 (등록한 API 키로 과금)
#
# 처음에는 false 로 두고 시작하는 걸 권장합니다.
# 화면 좌측 상단 배지를 눌러 언제든 켜고 끌 수 있고, 그 값이 이 파일보다 우선합니다.
PAID_APIS_ENABLED=false

# ── 📴 완전 로컬 모드 ─────────────────────────────────────────
# true 로 두면 외부 통신을 일절 하지 않습니다.
# PDF 추출 · 논문 검색 · E-book 리더 · 그림/표/참고문헌은 그대로 동작하고,
# AI 번역 · 그림분석 · AI 요약만 꺼집니다. (인터넷이 막힌 PC용)
OFFLINE_MODE=false

# ── 🏢 사내망(인트라넷) 배포용 설정 ───────────────────────────
# 회사 PC는 보통 구글 "로그인"이 막혀 있습니다. 크레딧(Vertex)은 로그인이 필요하므로 못 씁니다.
# 반면 Gemini API 키는 로그인이 아니라 HTTP 헤더에 키만 싣기 때문에 대개 동작합니다.
#   → 회사 배포는 아래를 false 로 두세요. 화면에서 크레딧 칸이 사라지고 시도조차 안 합니다.
#   → 집/개인 PC에서 GCP 크레딧도 쓰고 싶으면 true.
ENABLE_CREDIT=false

# 무엇이 막혀 있는지 그 PC에서 실제로 확인:  python webapp/backend/netcheck.py

# ── 🔍 검색 모드 ──────────────────────────────────────────────
# keyword = 로컬 검색만. 원문 구절만 보여줌. **완전 0원, 외부 호출 없음**
# ai      = 로컬로 찾은 구절을 AI가 요약 (등록한 API 키로 과금)
SEARCH_MODE=ai

# ── 🤖 모델 ───────────────────────────────────────────────────
TRANSLATE_CHANNEL=aistudio
TRANSLATE_MODEL=gemini-2.5-flash
# ANSWER_MODEL=gemini-2.5-flash

# ── 🌐 번역 공급자 (선택) ─────────────────────────────────────
# 기본은 gemini (위 TRANSLATE_CHANNEL·TRANSLATE_MODEL, 앱의 [사용자]에 등록한 키).
# claude 로 바꾸면 번역만 Claude(Anthropic API)로 나갑니다. 그림분석·AI 요약은 그대로 Gemini 입니다.
#   - 키는 화면이 아니라 아래 ANTHROPIC_API_KEY 에서 읽습니다. 사용량은 그 키가 속한 조직에 과금됩니다.
#   - 실측(2026-10-14, 7쪽 논문 1편, claude-opus-5-5): 입력 9,772 / 출력 7,943 토큰 ≈ $0.20
#     같은 분량이면 claude-sonnet-5-5 는 약 절반, claude-haiku-5-5 는 약 1/40 입니다(번역 품질은 직접 비교해 고르세요).
#   - 화면의 예상 비용은 공급자에 맞춰 바뀝니다(Claude = 쪽당, Gemini = 편당). 실제 사용량은 서버 창의 [번역] 줄(토큰 수)에 남습니다.
#   - Anthropic 호환 사내 게이트웨이를 쓸 때는 ANTHROPIC_BASE_URL 에 그 주소를 넣습니다.
#   - 예전 버전 위에 덮어써 올린 PC 는 한 번만 실행:  .venv\Scripts\python -m pip install anthropic
# TRANSLATE_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_TRANSLATE_MODEL=claude-opus-5-5
# CLAUDE_TRANSLATE_EFFORT=low
# ANTHROPIC_BASE_URL=

# ── 🖥️ 로컬 LLM (선택) ────────────────────────────────────────
# 논문 내용을 PC 밖으로 내보내면 안 되는 경우에만. Ollama 설치 필요.
# 켜면 챗봇이 이 로컬 모델을 가장 먼저 시도하고, 꺼져 있으면 자동으로 넘어갑니다.
USE_LOCAL_LLM=false
# LOCAL_LLM_HOST=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen2.5:7b

# ── ☁️ GCP 크레딧 경로 (ENABLE_CREDIT=true 일 때만) ───────────
# BATTERY_RAG_GCP_PROJECT_ID=
# BATTERY_RAG_GCS_BUCKET=
# BATTERY_RAG_DATASTORE_ID=
# BATTERY_RAG_APP_ID=
ENABLE_RAG_INDEX=false

# OpenAlex 논문 검색에 붙일 내 이메일(선택). 넣으면 검색 제한이 더 넉넉해져요(polite pool). 비워 둬도 돼요.
OPENALEX_MAILTO=
